# === 源码 ===
KERNEL_SOURCE=https://gitlab.com/OnePlusOSS/android_kernel_oneplus_sm8350
KERNEL_BRANCH=oneplus/sm8350_u_14.0.0_oneplus9

# === 机器：A14 这棵 OSS 树 vendor/ 下只有 lahaina_QGKI.config 可见 ===
# lemonade 的 fragment 可能在 device 侧，核侧先用 lahaina_QGKI 做 base
KERNEL_CONFIG=vendor/lahaina_QGKI.config
ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# === 工具链：A14 + SM8350 这棵 OPlus 用 Clang 14 ===
CLANG_VERSION=r450784d
LLVM_I=true

# === KSU-Next，5.4 走 legacy ===
KERNELSU_SOURCE=https://github.com/KernelSU-Next/KernelSU-Next
KERNELSU_BRANCH=next

